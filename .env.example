# Copy this file to .env and fill in your keys
# The app also lets you enter keys in the Settings panel UI

# AI Provider - choose one
VITE_AI_PROVIDER=anthropic
# or: VITE_AI_PROVIDER=openai

# Anthropic Claude API Key (get from console.anthropic.com)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (get from platform.openai.com)
VITE_OPENAI_API_KEY=sk-...

# Security Tool API Keys (used by proxy server - server.js)
# AbuseIPDB - free at abuseipdb.com
ABUSEIPDB_API_KEY=your_key_here

# VirusTotal - free at virustotal.com
VIRUSTOTAL_API_KEY=your_key_here

# URLScan.io - free at urlscan.io (optional, public API works without key)
URLSCAN_API_KEY=your_key_here

# Proxy server port
PROXY_PORT=3001
